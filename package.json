{
    "name": "npc-limpeza",
    "version": "2.0.0",
    "private": true,
    "description": "Checklist digital de limpeza - Neuropsicocentro",
    "scripts": {
        "build:css": "tailwindcss -i ./src/tailwind.css -o ./assets/tailwind.css --minify",
        "watch:css": "tailwindcss -i ./src/tailwind.css -o ./assets/tailwind.css --watch",
        "lint": "eslint .",
        "format": "prettier --write \"**/*.{js,css,html,json,md}\"",
        "test": "node --test tests/",
        "check": "npm run lint && npm test",
        "serve": "npx --yes http-server@14.1.1 -c-1 -p 8080 ."
    },
    "devDependencies": {
        "@eslint/js": "9.17.0",
        "eslint": "9.17.0",
        "globals": "15.14.0",
        "prettier": "3.4.2",
        "tailwindcss": "3.4.17"
    }
}
